# Copie este archivo a ".env" y complete los valores. El servidor lo lee solo,
# no hace falta instalar nada mas ni usar --env-file.

# Puerto donde escucha el servidor (opcional, por defecto 3004)
PUERTO=3004

# Cuenta de Gmail que envia los correos de recuperacion de clave y avisos de stock.
# GMAIL_APP_PASSWORD es una "contrasena de aplicacion" de 16 letras, no la clave normal
# de la cuenta. Se genera en https://myaccount.google.com/apppasswords (requiere tener
# la verificacion en dos pasos activada en esa cuenta de Google).
# Mientras estos dos valores no esten configurados, los correos solo se muestran en la
# consola del servidor (no se envian de verdad).
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=

# Clave secreta de reCAPTCHA (la que valida el servidor con Google). Dejar vacio en
# desarrollo local si no se tiene una clave de prueba propia.
# SECRETO_RECAPTCHA=
